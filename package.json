{
  "name": "family-region-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:index": "node scripts/prepare-index.mjs",
    "check:migrations": "node scripts/check-migration-versions.mjs",
    "dev": "npm run prepare:index && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:migrations && npm run prepare:index && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
